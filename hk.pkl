amends ".hk/org.pkl"

steps {
  // The step of the organization sets no `workspace_indicator`, so hk cannot render the `dir` of
  // the builtin step.
  ["cargo-deny"] { dir = "{{root}}" }
  // The test database has the user and the password `sqlc`. kingfisher reports its URI.
  ["kingfisher"] {
    check =
      "kingfisher scan {{ files }} --no-update-check --no-validate --quiet --redact --skip-regex 'postgres://sqlc:sqlc@'"
  }
  ["cargo-lockfile"] {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = List("slow")
  }
}
