amends
  "package://github.com/mathematic-inc/toolconfig/releases/download/v2026.11.6/toolconfig@2026.11.6#/ToolConfig.pkl"

root = true

toolconfig {
  `extends` =
    List(new Repository {
      git = "https://github.com/mathematic-inc/toolconfig-config.git"
      rev = "fc76ddad46c14a7b7fe03bf117a92ede11ea0dfb"
      path = "profiles/org/.toolconfig.pkl"
    })
}

sections {
  ["*"] {
    `cargo-deny` {
      advisories {
        ignore {
          new {
            id = "RUSTSEC-2026-0543"
            reason = "chrono is unmaintained and has no fix; sqlx and the generated code use it"
          }
        }
      }
    }
  }
  ["*.proto"] {
    buf {
      modules { new { path = "proto" } }
      // sqlc-dev/sqlc owns this copy of its plugin protocol.
      lint { ignore_only { ["PACKAGE_VERSION_SUFFIX"] = List("proto/plugin/codegen.proto") } }
    }
  }
}
